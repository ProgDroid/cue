# cue configuration — copy to .env and fill in. NEVER commit .env.
#
# ── Secrets & runtime config ────────────────────────────────────────────────
# Used by BOTH `cargo run` (local) AND Docker (via docker-compose env_file).
# This is the section that matters inside the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Catalogue sync (Plan 4) — all server-side, never sent to the client
MOTN_API_KEY=
PLEX_URL=
PLEX_TOKEN=
# ISO-3166 alpha-2 country code for Movie-of-the-Night API (e.g., gb for UK, us for US)
REGION=gb
# 6-field cron (sec min hour dom mon dow) for tokio-cron-scheduler — daily 03:00
SYNC_CRON=0 0 3 * * *

# ── Local `cargo run` ONLY — IGNORED under Docker ────────────────────────────
# The image bakes production values and docker-compose.yml pins these via
# `environment:` (which overrides env_file), so editing them here has NO effect
# in a container. They exist only for running the binary directly on your
# machine. In particular, BIND_ADDR=127.0.0.1 is a LOCAL default; the container
# must bind 0.0.0.0 (compose handles that) or the published port is unreachable.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite:./data/cue.db
STATIC_DIR=frontend/dist
RUST_LOG=info,sqlx=warn
